{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "*.md",
      "*.log",
      "dev-server.js",
      "serve.js",
      "verify.js",
      "verify_with_server.js",
      "check_getsession.js",
      "package.json",
      "package-lock.json",
      "lapink-insomnia.json",
      "AGENTES_STATUS.md",
      "**/node_modules/**",
      "functions/**",
      "data/**",
      "admin/recuperacao.html",
      "public/diagnostico.html",
      "screenshots/**",
      ".env",
      "**/.git/**",
      ".git/**",
      ".claude/**",
      ".vscode/**",
      "firestore.rules",
      "firestore.rules.secure",
      "firestore.indexes.json",
      "storage.rules"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/public/V1.html"
      },
      {
        "source": "/admin",
        "destination": "/admin/admin.html"
      },
      {
        "source": "/login",
        "destination": "/public/login.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Security-Policy", "value": "default-src 'self' https:; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://sdk.mercadopago.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net data:; img-src 'self' https: data: blob:; connect-src 'self' https:; frame-src https://lapink-82a39.firebaseapp.com https://accounts.google.com https://www.mercadopago.com https://*.mercadopago.com https://www.mercadopago.com.br https://*.mercadopago.com.br; object-src 'none'; base-uri 'self'; form-action 'self' https://www.mercadopago.com https://*.mercadopago.com https://www.mercadopago.com.br https://*.mercadopago.com.br; frame-ancestors 'self'" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=600" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
