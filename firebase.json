{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "*.md",
      "*.log",
      "dev-server.js",
      "serve.js",
      "verify.js",
      "verify_with_server.js",
      "check_getsession.js",
      "package.json",
      "package-lock.json",
      "lapink-insomnia.json",
      "AGENTES_STATUS.md",
      "**/node_modules/**",
      "functions/**",
      "data/**",
      "screenshots/**",
      ".env",
      "**/.git/**",
      ".git/**",
      ".claude/**",
      ".vscode/**",
      "firestore.rules",
      "firestore.rules.secure",
      "firestore.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/public/V1.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp|gif|svg|ico|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
