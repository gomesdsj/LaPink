    {
      "_id": "grp_permissoes",
      "parentId": "wrk_lapink",
      "_type": "request_group",
      "name": "🔒 Validação de Permissões"
    },

    {
      "_id": "req_sem_token",
      "parentId": "grp_permissoes",
      "_type": "request",
      "name": "Sem token → 401",
      "method": "GET",
      "url": "{{ base_url }}/api/produtos",
      "description": "Deve retornar 401 Não autenticado.",
      "headers": []
    },

    {
      "_id": "req_admin_sem_produtos",
      "parentId": "grp_permissoes",
      "_type": "request",
      "name": "Admin restrito tenta acessar Produtos → 403",
      "method": "GET",
      "url": "{{ base_url }}/api/produtos",
      "description": "Fluxo:\n1. Execute 'Criar admin — acesso restrito' em Usuários\n2. Execute 'Login — Admin' em Auth\n3. Cole o token do admin (não do superadmin) aqui\n4. Deve retornar 403 com as abas permitidas.",
      "headers": [{ "name": "Authorization", "value": "Bearer COLE_TOKEN_DO_ADMIN_RESTRITO" }]
    },

    {
      "_id": "req_admin_com_pedidos",
      "parentId": "grp_permissoes",
      "_type": "request",
      "name": "Admin restrito acessa Pedidos → 200 ✅",
      "method": "GET",
      "url": "{{ base_url }}/api/pedidos",
      "description": "O admin restrito TEM acesso a 'pedidos'. Deve retornar 200.",
      "headers": [{ "name": "Authorization", "value": "Bearer COLE_TOKEN_DO_ADMIN_RESTRITO" }]
    },

    {
      "_id": "req_admin_tenta_super",
      "parentId": "grp_permissoes",
      "_type": "request",
      "name": "Admin tenta acessar Usuários → 403",
      "method": "GET",
      "url": "{{ base_url }}/api/usuarios",
      "description": "Qualquer usuário sem role=superadmin deve receber 403.",
      "headers": [{ "name": "Authorization", "value": "Bearer COLE_TOKEN_DO_ADMIN_RESTRITO" }]
    },

    {
      "_id": "grp_migracao",
      "parentId": "wrk_lapink",
      "_type": "request_group",
      "name": "📤 Migração (localStorage → servidor)"
    },

    {
      "_id": "req_export",
      "parentId": "grp_migracao",
      "_type": "request",
      "name": "Exportar dados do servidor",
      "method": "GET",
      "url": "{{ base_url }}/api/export",
      "description": "Retorna todo o db.json (produtos, pedidos, clientes). Útil para backup.",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },

    {
      "_id": "req_import",
      "parentId": "grp_migracao",
      "_type": "request",
      "name": "Importar dados do localStorage",
      "method": "POST",
      "url": "{{ base_url }}/api/import",
      "description": "Cole aqui o JSON exportado do localStorage (via console do browser):\n\nJSON.stringify({\n  produtos:  JSON.parse(localStorage.lapinkProdutos || '[]'),\n  pedidos:   JSON.parse(localStorage.lapinkPedidos  || '[]'),\n  clientes:  JSON.parse(localStorage.lapinkClients  || '[]'),\n  config:    JSON.parse(localStorage.lapinkStoreConfig || '{}'),\n  lojaConfig:JSON.parse(localStorage.lapinkLojaConfig || '{}')\n})",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"produtos\": [],\n  \"pedidos\": [],\n  \"clientes\": []\n}"
      }
    }

