      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"cliente\": { \"name\": \"Maria Teste\", \"whatsapp\": \"11999999999\" },\n  \"itens\": [\n    { \"nome\": \"Anel Prata Cristal\", \"preco\": 59.90, \"qty\": 2 }\n  ],\n  \"total\": 119.80,\n  \"status\": \"aguardando\",\n  \"pago\": false\n}"
      }
    },

    {
      "_id": "req_patch_status",
