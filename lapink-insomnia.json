    {
      "_id": "grp_auth",
      "parentId": "wrk_lapink",
      "_type": "request_group",
      "name": "🔐 Autenticação"
    },

    {
      "_id": "req_login_super",
      "parentId": "grp_auth",
      "_type": "request",
      "name": "Login — Super Admin",
      "method": "POST",
      "url": "{{ base_url }}/api/auth/login",
      "description": "Senha padrão: 123456 (SHA-256 já preenchido na variável de ambiente).\nCopie o token da resposta e cole em {{ token }} no Environment.",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ superadmin_email }}\",\n  \"password\": \"{{ superadmin_password_sha256 }}\"\n}"
      }
    },

    {
      "_id": "req_login_admin",
      "parentId": "grp_auth",
      "_type": "request",
      "name": "Login — Admin (teste de permissões)",
      "method": "POST",
      "url": "{{ base_url }}/api/auth/login",
      "description": "Use para testar um admin criado em POST /api/usuarios.\nAlter password_sha256 conforme a senha definida.",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ admin_email }}\",\n  \"password\": \"8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92\"\n}"
      }
    },

    {
      "_id": "req_me",
      "parentId": "grp_auth",
      "_type": "request",
      "name": "Quem sou eu (me)",
      "method": "GET",
      "url": "{{ base_url }}/api/auth/me",
      "description": "Retorna dados do usuário do token atual.",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },

    {
      "_id": "req_logout",
      "parentId": "grp_auth",
      "_type": "request",
      "name": "Logout",
      "method": "POST",
      "url": "{{ base_url }}/api/auth/logout",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }],
      "body": { "mimeType": "application/json", "text": "{}" }
    },

    {
      "_id": "grp_produtos",
      "parentId": "wrk_lapink",
      "_type": "request_group",
      "name": "📦 Produtos"
    },

    {
      "_id": "req_get_produtos",
      "parentId": "grp_produtos",
      "_type": "request",
      "name": "Listar produtos",
      "method": "GET",
      "url": "{{ base_url }}/api/produtos",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },

    {
      "_id": "req_post_produto",
      "parentId": "grp_produtos",
      "_type": "request",
      "name": "Criar produto",
      "method": "POST",
      "url": "{{ base_url }}/api/produtos",
      "description": "O servidor gera o id automaticamente. Salve o id retornado em {{ produto_id }}.",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nome\": \"Anel Prata Cristal\",\n  \"categoria\": \"Anel\",\n  \"precoVarejo\": 59.90,\n  \"estoque\": 10,\n  \"descricao\": \"Anel folheado prata com pedra cristal\"\n}"
      }
    },

    {
      "_id": "req_put_produto",
      "parentId": "grp_produtos",
      "_type": "request",
      "name": "Atualizar produto",
      "method": "PUT",
      "url": "{{ base_url }}/api/produtos/{{ produto_id }}",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"nome\": \"Anel Prata Cristal — Atualizado\",\n  \"categoria\": \"Anel\",\n  \"precoVarejo\": 69.90,\n  \"estoque\": 8,\n  \"descricao\": \"Anel folheado prata com pedra cristal (atualizado)\"\n}"
      }
    },

    {
      "_id": "req_delete_produto",
      "parentId": "grp_produtos",
      "_type": "request",
      "name": "Excluir produto",
      "method": "DELETE",
      "url": "{{ base_url }}/api/produtos/{{ produto_id }}",
      "headers": [{ "name": "Authorization", "value": "Bearer {{ token }}" }]
    },

    {
