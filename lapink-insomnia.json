      "name": "Criar admin — acesso restrito (só Pedidos + Clientes)",
      "method": "POST",
      "url": "{{ base_url }}/api/usuarios",
      "description": "Cria um admin com acesso apenas às abas 'pedidos' e 'clientes'.\nUse este usuário para testar o bloqueio de abas em 🔒 Permissões.",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ admin_email }}\",\n  \"name\": \"Admin Restrito\",\n  \"role\": \"admin\",\n  \"password\": \"8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92\",\n  \"pages\": [\"pedidos\", \"clientes\"]\n}"
      }
    },

    {
      "_id": "req_post_admin_total",
      "parentId": "grp_usuarios",
      "_type": "request",
      "name": "Criar admin — acesso total",
