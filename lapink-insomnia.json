      "url": "{{ base_url }}/api/usuarios",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"admin2@lapink.com\",\n  \"name\": \"Admin Total\",\n  \"role\": \"admin\",\n  \"password\": \"8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92\",\n  \"pages\": null\n}"
      }
    },

    {
      "_id": "req_put_usuario_pages",
      "parentId": "grp_usuarios",
      "_type": "request",
      "name": "Editar permissões de admin (pages)",
      "method": "PUT",
      "url": "{{ base_url }}/api/usuarios/{{ admin_email }}",
      "description": "Altera as abas visíveis do admin. Use null para acesso total.\nAbas válidas: dashboard, produtos, pedidos, clientes, loja-v1, relatorios, financeiro, configuracoes",
      "headers": [
        { "name": "Authorization", "value": "Bearer {{ token }}" },
        { "name": "Content-Type",  "value": "application/json" }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Admin Restrito\",\n  \"role\": \"admin\",\n  \"pages\": [\"pedidos\", \"clientes\", \"relatorios\"]\n}"
