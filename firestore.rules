rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // POSTURA: default-deny. Só os documentos PÚBLICOS de catálogo/config
    // (sem segredos, sem PII, sem credenciais) são liberados.
    //
    // NEGADOS por não estarem na lista (não há regra que os permita):
    //   • lapinkClients     → PII de clientes + hashes de senha
    //   • lapinkUsers        → admins (e-mail + hash + role) — fecha o
    //                          takeover: ninguém grava um superadmin aqui
    //   • lapinkApiConfig    → pode conter chaves (EmailJS/MP)
    //   • apiConfig          → token do Mercado Pago (lido só via Admin SDK)
    //
    // OBS: a escrita dos docs públicos ainda é aberta porque o painel admin
    // não usa Firebase Auth (publica via cloud-sync). Risco residual = vandalismo
    // do catálogo. Lockdown total ("só admin escreve") exige migrar o login do
    // painel para Firebase Auth — ver firestore.rules.secure.
    // ════════════════════════════════════════════════════════════════

    function isDocPublico(doc) {
      return doc in [
        'lapinkProdutos',
        'lapinkLojaConfig',
        'lapinkStoreConfig',
        'lapinkCarrossel',
        'lapinkNotifConfig',
        'lapinkEntregaConfig',
        'lapinkPaymentConfig',
        'lapinkConfig',
        'lapinkPedidoCounter',
        'lapinkPedidos',
        'lapinkCategorias',
        'lapinkBeneficios'
      ]
      // Partes de docs grandes (>1 MiB) — o cloud-sync divide catálogos com
      // fotos em lapinkProdutos_0, _1, … (idem pedidos/carrossel/config da loja)
      || doc.matches('(lapinkProdutos|lapinkPedidos|lapinkCarrossel|lapinkLojaConfig)_[0-9]+');
    }

    // Segredos (token Mercado Pago, Manda Bem/Melhor Envio, etc.).
    // LEITURA NUNCA liberada (não vaza os tokens ao cliente). ESCRITA liberada
    // para o admin salvar pelo painel (o painel ainda não usa Firebase Auth).
    // As Cloud Functions leem via Admin SDK (ignoram as rules). Risco residual:
    // alguém sobrescrever um token (sabota, não lê) — aceitável no momento.
    match /lapink/apiConfig {
      allow write: if true;   // read continua negado (sem allow read)
    }

    match /lapink/{doc} {
      allow read, write: if isDocPublico(doc);
      // Qualquer outro doc em /lapink/ (lapinkClients, lapinkUsers,
      // lapinkApiConfig…) → negado (sem allow = sem acesso).
    }

    // Perfis de usuário do Firebase Auth. Cada um lê/grava só o SEU perfil,
    // MAS não pode se auto-promover: ao gravar, o campo `role` só pode ser
    // 'client' (ou ausente). Papéis de admin/superadmin são definidos apenas
    // via Console do Firebase ou Admin SDK (que ignoram estas rules).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (!('role' in request.resource.data) || request.resource.data.role == 'client');
    }

    // Carrinhos abandonados — cliente cria/atualiza o próprio; admin lê pelo painel.
    // Delete só via Admin SDK.
    match /abandonados/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Endereços salvos pelo cliente (Minha conta / pagamento) — o painel admin
    // lê para exibir no perfil do cliente. Mesmo padrão de risco de /abandonados
    // e /pedidos (que já carregam endereço de entrega em doc público): sem
    // senha/credencial, apenas dados de entrega. Delete só via Admin SDK.
    match /enderecos/{id} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Pedidos criados via Cloud Functions (Admin SDK ignora as rules).
    // Leitura pública para o cliente acompanhar pelo ID.
    // Criação/exclusão bloqueadas. Update do painel limitado a rastreio/status —
    // impede terceiros de alterar total, itens, pagamento ou marcar estoqueBaixado.
    match /pedidos/{pedidoId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['rastreio', 'status', 'updatedAt']);
    }
  }
}
