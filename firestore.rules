rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // POSTURA: default-deny. Só os documentos PÚBLICOS de catálogo/config
    // (sem segredos, sem PII, sem credenciais) têm LEITURA liberada — e
    // mesmo esses só podem ser ESCRITOS por um admin autenticado.
    //
    // NEGADOS por não estarem na lista (não há regra que os permita):
    //   • lapinkClients     → PII de clientes + hashes de senha
    //   • lapinkUsers        → admins (e-mail + hash + role) — fecha o
    //                          takeover: ninguém grava um superadmin aqui
    //   • lapinkApiConfig    → pode conter chaves (EmailJS/MP)
    //   • apiConfig          → token do Mercado Pago (lido só via Admin SDK)
    //
    // ESCRITA do catálogo/config e dos segredos (apiConfig) agora exige
    // isAdmin() — todo o painel já carrega firebase-auth-compat.js, espera a
    // sessão (aguardarFirebaseAuth) antes de listar/gravar, e sincroniza a
    // claim de role via sincronizarClaimsAdmin no login. Antes disso, era
    // aberto pra qualquer um (mesmo sem login nenhum): dava pra vandalizar o
    // catálogo, sabotar o token do Mercado Pago, e — pior — injetar HTML/JS
    // no nome de um produto, que o painel mostra sem escapar (some com a
    // fonte de XSS persistente contra qualquer admin que abrir a lista).
    //
    // A LEITURA de coleções com PII (pedidos, abandonados) já usa Firebase
    // Auth + custom claim (isAdmin(), função sincronizarClaimsAdmin): listar
    // a coleção inteira agora exige admin logado; buscar 1 documento por ID
    // já conhecido continua público (é como o cliente acompanha o próprio
    // pedido, por exemplo).
    // ════════════════════════════════════════════════════════════════

    // Painel admin agora sincroniza role/pages como CUSTOM CLAIM no Firebase
    // Auth (função sincronizarClaimsAdmin, Admin SDK — cliente não escreve
    // isso direto, então dá pra confiar aqui). Usado para proteger LISTAGEM
    // de coleções com PII (pedidos, carrinhos abandonados) sem exigir que o
    // catálogo/config pública deixe de ser aberta (isso ainda depende da
    // migração completa descrita no comentário abaixo).
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    function isDocPublico(doc) {
      return doc in [
        'lapinkProdutos',
        'lapinkLojaConfig',
        'lapinkStoreConfig',
        'lapinkCarrossel',
        'lapinkNotifConfig',
        'lapinkEntregaConfig',
        'lapinkPaymentConfig',
        'lapinkConfig',
        'lapinkPedidoCounter',
        'lapinkPedidos',
        'lapinkCategorias',
        'lapinkBeneficios',
        'lapinkEmailConfig'
      ]
      // Partes de docs grandes (>1 MiB) — o cloud-sync divide catálogos com
      // fotos em lapinkProdutos_0, _1, … (idem pedidos/carrossel/config da loja)
      || doc.matches('(lapinkProdutos|lapinkPedidos|lapinkCarrossel|lapinkLojaConfig)_[0-9]+');
      // OBS: lapinkEmailConfig guarda só a Public Key do EmailJS + IDs de
      // serviço/template — por design do EmailJS essas informações são para
      // uso no client-side (não são credenciais de acesso à conta). Precisa
      // ser público para QUALQUER visitante disparar o e-mail de boas-vindas.
    }

    // Segredos (token Mercado Pago, Manda Bem/Melhor Envio, etc.).
    // LEITURA NUNCA liberada (não vaza os tokens ao cliente). ESCRITA exige
    // admin autenticado — antes bastava saber o nome do doc pra sobrescrever
    // (sabotar) o token de pagamento/frete de qualquer navegador, sem login.
    // As Cloud Functions leem via Admin SDK (ignoram as rules).
    match /lapink/apiConfig {
      allow write: if isAdmin();   // read continua negado (sem allow read)
    }

    match /lapink/{doc} {
      allow read: if isDocPublico(doc);
      allow write: if isDocPublico(doc) && isAdmin();
      // Qualquer outro doc em /lapink/ (lapinkClients, lapinkUsers,
      // lapinkApiConfig…) → negado (sem allow = sem acesso).
    }

    // Perfis de usuário do Firebase Auth. Cada um lê/grava só o SEU perfil,
    // MAS não pode se auto-promover: ao gravar, o campo `role` só pode ser
    // 'client' (ou ausente). Papéis de admin/superadmin são definidos apenas
    // via Console do Firebase ou Admin SDK (que ignoram estas rules).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && (!('role' in request.resource.data) || request.resource.data.role == 'client');
    }

    // Carrinhos abandonados — cliente cria/atualiza o próprio (sem auth, é
    // só o carrinho dele). "list" (dump de TODOS os carrinhos — nome,
    // telefone, itens) agora exige admin autenticado; nada no site faz get
    // avulso aqui hoje, então só liberar list pro admin não quebra nada.
    match /abandonados/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if false;
    }

    // Endereços salvos pelo cliente (Minha conta / pagamento) — o painel admin
    // lê por e-mail (doc por ID conhecido) para exibir no perfil do cliente.
    // "get" (1 doc, ID já conhecido) fica aberto — é o único jeito de uso hoje.
    // "list" (dump da coleção inteira) fica bloqueado: ninguém no site faz
    // list aqui, então bloquear não quebra nada e evita vazar o endereço de
    // TODOS os clientes para quem descobrir que a coleção existe.
    match /enderecos/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if false;
    }

    // Pedidos criados via Cloud Functions (Admin SDK ignora as rules).
    // "get" (1 pedido por ID já conhecido, ex.: sucesso.html?pedido=LPK-XXX)
    // continua público — é assim que o cliente acompanha a própria compra.
    // "list" exige qualquer usuário AUTENTICADO (cliente ou admin) — fecha o
    // furo real (visitante anônimo, sem conta nenhuma, listando TODOS os
    // pedidos — nome, CPF, endereço, itens, total — só de saber que a
    // coleção existe). meus-pedidos.html já faz a query filtrada pelo
    // próprio e-mail (where cliente.email == ...), então continua só
    // trazendo os pedidos do próprio cliente logado — não muda nada pra
    // quem usa o site normalmente. Fechar 100% (nem cliente logado listar
    // pedido alheio via query sem filtro) exigiria mover pedidos para uma
    // subcoleção por usuário — melhoria maior, registrada para depois.
    // Update: só admin, e mesmo assim só nos campos de rastreio/status —
    // antes disso, QUALQUER PESSOA podia alterar o status ou o código de
    // rastreio de um pedido alheio, sem autenticação nenhuma.
    // Criação/exclusão continuam bloqueadas (só a Function cria/apaga).
    match /pedidos/{pedidoId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, delete: if false;
      allow update: if isAdmin() && request.resource.data.diff(resource.data)
                      .affectedKeys().hasOnly(['rastreio', 'status', 'updatedAt']);
    }

    // Analytics leves (visitas ao site, visualizações de produto). Só
    // gravado pelas Cloud Functions registrarVisita/registrarVisualizacao-
    // Produto via Admin SDK (ignora estas rules) — o cliente NUNCA escreve
    // aqui direto, senão bastaria chamar setDoc pra inflar os números.
    // Leitura só para admin (é o que alimenta a aba de Analytics do painel).
    match /analytics/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Dedupe interno das Functions acima (1 doc por IP+dia). Não tem por
    // que ser lido nem escrito por ninguém fora da Function.
    match /analyticsDedupe/{doc} {
      allow read, write: if false;
    }
  }
}
